# Environment Variables for Knows About Tree
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/knows_about_tree"

# NextAuth
AUTH_SECRET="your-random-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (optional for development - local upload fallback is available)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Provider: "mock" | "plantnet" | "plantid"
AI_PROVIDER="mock"

# PlantNet API (free tier available at https://my.plantnet.org/)
PLANTNET_API_KEY="your-plantnet-api-key"

# Plant.id API (alternative provider)
PLANTID_API_KEY="your-plantid-api-key"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="10"
RATE_LIMIT_WINDOW_MS="60000"

# Upload Limits
MAX_FILE_SIZE_MB="10"
MAX_FILES_PER_UPLOAD="10"
